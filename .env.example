# Resend
RESEND_API_KEY=
LEAD_INBOX_EMAIL=lead@indoles.com.tr
SALES_INBOX_EMAIL=sales@indoles.com.tr


# Google Analytics 4
# Yalnizca NEXT_PUBLIC_APP_STAGE=production iken yuklenir; Vercel'de set edilecek.
NEXT_PUBLIC_GA_ID=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Cal.com
CAL_COM_EMBED_URL=https://cal.com/indoles/gorusme
NEXT_PUBLIC_CAL_COM_LINK=indoles/gorusme

# Arama motoru sahiplik dogrulamasi (Vercel'de tanimlanir, repoya yazilmaz)
# Google Search Console > Ayarlar > Sahiplik dogrulamasi > HTML etiketi
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools > Siteyi dogrula > Meta etiketi (msvalidate.01)
NEXT_PUBLIC_BING_SITE_VERIFICATION=
