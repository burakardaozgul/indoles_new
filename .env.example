# === Dagitim (Cloudflare Workers / OpenNext) ===
# Bu iki degisken launch'in en pahali konfigurasyon riskidir (denetim LG-02).
#
# NEXT_PUBLIC_APP_STAGE production DEGILSE:
#   - robots.txt tum siteyi "Disallow: /" yapar  -> site komple indekslenmez
#   - kok layout noindex basar
#   - GA4 hic yuklenmez
# Deploy sonrasi ILK kontrol: curl https://www.indoles.com.tr/robots.txt
NEXT_PUBLIC_APP_STAGE=development

# Kanonik host — ADR-024 ile **www** (apex degil).
# canonical, hreflang, sitemap, robots ve llms.txt bu degerden turuyor.
# Production'da: https://www.indoles.com.tr
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare (deploy) — API token'i BURAYA YAZILMAZ.
# `wrangler secret put` ile ya da CI secret'i olarak verilir.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=


# Resend
RESEND_API_KEY=
LEAD_INBOX_EMAIL=lead@indoles.com.tr
SALES_INBOX_EMAIL=sales@indoles.com.tr


# Google Analytics 4
# Yalnizca NEXT_PUBLIC_APP_STAGE=production iken yuklenir; Cloudflare'de set edilecek.
NEXT_PUBLIC_GA_ID=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Takvim — Cal.com kaldirildi (ADR-025); kendi takvim sistemi entegre
# edildiginde embed/link URL'i buraya eklenecek.

# Arama motoru sahiplik dogrulamasi (Cloudflare ortam degiskeni olarak tanimlanir, repoya yazilmaz)
# Google Search Console > Ayarlar > Sahiplik dogrulamasi > HTML etiketi
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools > Siteyi dogrula > Meta etiketi (msvalidate.01)
NEXT_PUBLIC_BING_SITE_VERIFICATION=
