{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@sanity/*": ["./sanity/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "sst-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "sst.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "drizzle.config.ts",
    "tailwind.config.ts",
    "next.config.ts",
    // `.open-next/worker.js`'i saran Cloudflare Worker sarmalayıcısı
    // (bkz. dosyanın kendi başlık yorumu). Build zamanında üretilen bir
    // dosyayı import ediyor (depoda durmaz, .gitignore) ve bu depoda
    // bilerek kurulu olmayan Workers ambient tiplerine (ExportedHandler vb.,
    // Görev 4 ruling'i) dayanmıyor — diğer kök yapılandırma dosyalarıyla
    // aynı gerekçeyle tsc programının dışında.
    "custom-worker.ts"
  ]
}
