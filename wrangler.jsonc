{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "indoles-web",
  "main": ".open-next/worker.js",
  "account_id": "05ac1dc62c4c62391d47923ddebeef03",

  // Adaptörün istediği taban 2024-09-23; kurulu workerd (1.20260820.x) daha
  // yenisini destekliyor, o yüzden güncel bir tarihe sabitlendi — eski tarih
  // wrangler'dan "daha yeni bir tarihe geçin" uyarısı alıyordu.
  "compatibility_date": "2026-08-20",
  "compatibility_flags": [
    // Node.js API'leri (adaptörün kendisi, worker-mailer ve Sentry bunu bekliyor)
    "nodejs_compat",
    // fetch() yalnız gerçek dış adreslere gitsin — Worker kendi kendine
    // çağrı yapıp döngüye girmesin
    "global_fetch_strictly_public"
  ],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
    // run_worker_first varsayılan (false): statik varlıklar Worker'a hiç
    // uğramadan servis edilir — hem hızlı hem faturasız. Site SSG olduğu
    // için isteklerin büyük çoğunluğu buradan karşılanacak.
  },

  "observability": {
    "enabled": true
  },

  // Doğrulama alanı. `*.workers.dev` Türkiye'deki bazı ağlardan HTTPS ile
  // açılmıyor (SNI engellemesi) — kendi alan adımızdaki bir alt alan, cutover
  // öncesi gerçek koşullarda duman testi yapmanın tek yolu. www'ye ve
  // WordPress'e dokunmaz.
  //
  // CUTOVER 2026-08-28: www bu Worker'a bağlı — WordPress devre dışı.
  // Kanonik host `www` (ADR-024).
  //
  // `preview.indoles.com.tr` cutover'dan sonra KALDIRILDI. Sebebi tek Worker
  // olması: iki host aynı script'i servis ettiği için preview kendi robots'unu
  // alamıyordu, üretim robots'unu (Allow) servis ediyordu — indekslenme riski.
  // Doğrulama artık üretim öncesi `pnpm cf:preview` (yerel) ve CI'daki
  // robots/SEO kontrolleriyle yapılıyor. Ayrı bir doğrulama adresi gerekirse
  // AYRI bir Worker script'i olarak kurulmalı, aynı script'e ikinci host değil.
  "routes": [{ "pattern": "www.indoles.com.tr", "custom_domain": true }],

  // NOT: `NEXT_PUBLIC_*` değişkenleri buraya YAZILMAZ — onlar build anında
  // koda gömülüyor, çalışma zamanında okunmuyor. Değerleri `package.json`
  // içindeki `cf:build` script'inde duruyor (LG-02: stage yanlışsa site
  // komple indeks dışı çıkar, o yüzden script'e gömüldü — unutulamasın).
  //
  // Sır OLMAYAN çalışma zamanı ayarları burada duruyor: versiyonlanıyor,
  // gözle görülüyor, yeniden kurulumda elle girilmesi gerekmiyor.
  // Gerçek sırlar (SMTP_PASS, TURNSTILE_SECRET_KEY, SENTRY_DSN) repoya
  // yazılmaz; `wrangler secret put <AD>` ile tanımlanır.
  "vars": {
    // Mail: Veridyen SMTP (ADR-026). Host proxy'siz olmak zorunda —
    // mail.indoles.com.tr Cloudflare proxy'sinde ve SMTP taşımaz.
    "SMTP_HOST": "polo.veridyen.com",
    "SMTP_PORT": "587",
    "SMTP_USER": "noreply@indoles.com.tr",

    // Gönderen sunucu tarafından dayatılıyor: Exim zarf ve header From'un
    // kimlik doğrulanan kutuya eşit olmasını şart koşuyor (550). Yanıtlar
    // Reply-To ile doğru kutuya döner.
    "MAIL_FROM": "INDOLES <noreply@indoles.com.tr>",
    "MAIL_REPLY_TO": "digital@indoles.com.tr",

    // Lead bildirimi üç kutuya birden gider; virgülle ayrılır ve
    // lib/mail/client.ts `recipients()` diziye çevirir.
    "LEAD_INBOX_EMAIL": "digital@indoles.com.tr,burak@indoles.com.tr,b.a.ozgul@gmail.com",
    "SALES_INBOX_EMAIL": "digital@indoles.com.tr,burak@indoles.com.tr,b.a.ozgul@gmail.com",

    // Müsaitlik birden fazla takvimden okunuyor (spec §2.1b): iş takvimi ve
    // "yalnız müsaitlik" düzeyinde paylaşılan kişisel takvim. Sır değil —
    // takvim kimliği zaten paylaşım davetinde açık; virgülle ayrılır.
    "BOOKING_CALENDAR_IDS": "digital@indoles.com.tr,b.a.ozgul@gmail.com"
  },

  // Rezervasyon kayıtları. Kalıcı DB launch kapsamında yoktu (ADR-010);
  // rezervasyon sistemi onu tek bir tablo için geri getiriyor: çakışma kilidi
  // uygulama kodunda tutulamıyor — "önce kontrol et sonra yaz" eşzamanlı iki
  // istekte aynı slotu iki kez satar. Kısıt veritabanında, kısmi unique
  // indeks olarak duruyor (migrations/0001_bookings.sql).
  //
  // database_id sır değil: yetki API token'ında, kimlikte değil.
  "d1_databases": [
    {
      "binding": "BOOKINGS_DB",
      "database_name": "indoles-bookings",
      "database_id": "0cde790c-6ba4-4cb6-b94f-7041152e14b5",
      "migrations_dir": "migrations"
    }
  ]
}
